# AgencyOS v0.7 configuration
# Copy to .env.local for development. Never commit real credentials.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Multi-tenant identity and browser sessions
# disabled: trusted local development only
# bootstrap: break-glass owner token for first-tenant administration
# database: tenant members authenticate with API keys or OIDC-backed sessions
AGENCY_AUTH_MODE=disabled
AGENCY_BOOTSTRAP_OWNER_TOKEN=
AGENCY_BOOTSTRAP_OWNER_NAME=Agency Owner
AGENCY_BOOTSTRAP_OWNER_EMAIL=
# M5 compatibility only. Prefer AGENCY_BOOTSTRAP_OWNER_TOKEN.
AGENCY_REQUIRE_OPERATOR_AUTH=false
AGENCY_OPERATOR_TOKEN=
AGENCY_TENANT_ID=agency-default
AGENCY_SESSION_COOKIE_NAME=agency_session
AGENCY_SESSION_TTL_HOURS=12
AGENCY_OIDC_TRANSACTION_TTL_MINUTES=10
# Exact comma-separated issuer hostnames approved by the platform operator.
AGENCY_OIDC_ALLOWED_ISSUER_HOSTS=
# Development-only escape hatches for a local identity provider.
AGENCY_OIDC_ALLOW_INSECURE_HTTP=false
AGENCY_OIDC_ALLOW_PRIVATE_ISSUERS=false
AGENCY_OIDC_REQUIRE_VERIFIED_EMAIL=true

# Default approval posture; tenant policy documents can make this stricter.
AGENCY_REQUIRE_SEPARATE_APPROVER=true
AGENCY_HIGH_RISK_APPROVALS=2

# Encryption for tenant-owned integration and OIDC secrets.
# Generate exactly 32 random bytes encoded as base64: openssl rand -base64 32
AGENCY_SECRET_ENCRYPTION_KEY=
AGENCY_SECRET_KEY_ID=agency-os-local-v1
# Development/migration only; production validation rejects this setting.
AGENCY_ALLOW_GLOBAL_INTEGRATION_FALLBACK=false

# Models
OPENAI_API_KEY=replace-me-with-your-openai-api-key
AGENCY_MODEL=openai/gpt-5.6-sol
AGENCY_WORKER_MODEL=openai/gpt-5.6-sol
AGENCY_QA_MODEL=openai/gpt-5.6-sol
AGENCY_MEMORY_MODEL=openai/gpt-5.6-sol
AGENCY_QA_MIN_SCORE=90
AGENCY_MAX_ATTEMPTS=3

# MongoDB
# Production needs a replica set or sharded cluster because state/outbox writes are transactional.
MONGODB_URI=mongodb+srv://replace-me:replace-me@cluster0.example.mongodb.net/
MONGODB_DATABASE=agency_os
AGENCY_TRANSACTIONS_REQUIRED=false

# Durable runner identity, routing, and leases
AGENCY_RUNNER_ID=
AGENCY_RUNNER_REGION=local
AGENCY_RUNNER_QUEUES=artifact,workspace,external-actions,events
AGENCY_RUNNER_RESOURCE_CLASSES=standard
AGENCY_RUNNER_LABELS=
AGENCY_RUNNER_CONCURRENCY=1
AGENCY_RUNNER_POLL_MS=2000
AGENCY_RUNNER_LEASE_MS=90000
AGENCY_RUNNER_HEARTBEAT_MS=20000
AGENCY_RUNNER_CONTROL_POLL_MS=2000
AGENCY_RUNNER_RETRY_DELAY_MS=15000
AGENCY_RUNNER_MAX_DELIVERIES=3
AGENCY_RUNNER_ORPHAN_GRACE_MS=180000

# Transactional outbox and signed domain-event delivery
AGENCY_OUTBOX_POLL_MS=1000
AGENCY_OUTBOX_LEASE_MS=60000
AGENCY_OUTBOX_MAX_DELIVERIES=5
AGENCY_OUTBOX_RETRY_DELAY_MS=15000
AGENCY_EVENT_WEBHOOK_URL=
AGENCY_EVENT_WEBHOOK_SECRET=

# Admission controls and policy budget units (not provider dollars)
# Global fleet limits are checked before tenant and project limits.
AGENCY_ADMISSION_MAX_GLOBAL_READY_JOBS=1000
AGENCY_ADMISSION_MAX_GLOBAL_ACTIVE_JOBS=100
AGENCY_ADMISSION_MAX_READY_JOBS=100
AGENCY_ADMISSION_MAX_ACTIVE_JOBS=20
AGENCY_ADMISSION_MAX_PROJECT_ACTIVE_JOBS=5
AGENCY_DAILY_EXECUTION_BUDGET_UNITS=10000
AGENCY_ARTIFACT_RUN_COST_UNITS=10
AGENCY_WORKSPACE_RUN_COST_UNITS=50

# Controlled repository workspaces
# remote-http is the production M7 path and removes Docker-socket access from AgencyOS runners.
AGENCY_WORKSPACE_PROVIDER=docker-isolated
AGENCY_REMOTE_SANDBOX_URL=
AGENCY_REMOTE_SANDBOX_HMAC_SECRET=
AGENCY_REMOTE_SANDBOX_TIMEOUT_MS=300000
AGENCY_REMOTE_SANDBOX_AUDIENCE=agency-os-sandbox
AGENCY_WORKSPACE_ROOT=/tmp/agency-os/workspaces
AGENCY_WORKSPACE_ALLOWED_GIT_HOSTS=github.com
AGENCY_WORKSPACE_ALLOW_LOCAL_REPOS=false
AGENCY_ALLOW_LOCAL_WORKSPACES_IN_PRODUCTION=false
AGENCY_WORKSPACE_MAX_CHANGED_FILES=40
AGENCY_WORKSPACE_MAX_FILE_BYTES=250000
AGENCY_WORKSPACE_MAX_TOTAL_WRITE_BYTES=2000000
AGENCY_WORKSPACE_CONTEXT_MAX_FILES=30
AGENCY_WORKSPACE_CONTEXT_MAX_BYTES=300000
AGENCY_WORKSPACE_DIFF_MAX_BYTES=500000
AGENCY_WORKSPACE_COMMAND_TIMEOUT_MS=180000
AGENCY_WORKSPACE_COMMAND_OUTPUT_MAX_BYTES=262144
AGENCY_WORKSPACE_VALIDATION_SCRIPTS=typecheck,test,lint
AGENCY_WORKSPACE_DEPENDENCY_MODE=none
AGENCY_GIT_AUTHOR_NAME=AgencyOS Worker
AGENCY_GIT_AUTHOR_EMAIL=agencyos@example.com

# Trusted local Docker validation provider (not used by remote-http)
AGENCY_SANDBOX_DOCKER_BINARY=docker
AGENCY_SANDBOX_HOST_WORKSPACE_ROOT=
AGENCY_SANDBOX_IMAGE=agency-os-sandbox:0.7.0
AGENCY_SANDBOX_NETWORK=none
AGENCY_SANDBOX_CPUS=1
AGENCY_SANDBOX_MEMORY_MB=1024
AGENCY_SANDBOX_PIDS_LIMIT=128
AGENCY_SANDBOX_TMPFS_MB=256
AGENCY_SANDBOX_DISK_BYTES=536870912
AGENCY_SANDBOX_USER=
AGENCY_SANDBOX_READ_ONLY=true
AGENCY_SANDBOX_DROP_CAPABILITIES=true
AGENCY_SANDBOX_NO_NEW_PRIVILEGES=true
AGENCY_SANDBOX_CLEANUP_TIMEOUT_MS=10000

# Durable evidence
# Use S3-compatible storage whenever web and runners do not share a filesystem.
AGENCY_ARTIFACT_PROVIDER=filesystem
AGENCY_ARTIFACT_ROOT=/tmp/agency-os/artifacts
AGENCY_ARTIFACT_MAX_BYTES=10000000
AGENCY_ARTIFACT_RETENTION_DAYS=30
AGENCY_ARTIFACT_GC_INTERVAL_MS=3600000
AGENCY_S3_REGION=us-east-1
AGENCY_S3_ENDPOINT=
AGENCY_S3_BUCKET=
AGENCY_S3_PREFIX=agency-os
AGENCY_S3_FORCE_PATH_STYLE=false
AGENCY_S3_ACCESS_KEY_ID=
AGENCY_S3_SECRET_ACCESS_KEY=
AGENCY_S3_SESSION_TOKEN=
AGENCY_S3_SERVER_SIDE_ENCRYPTION=
AGENCY_S3_KMS_KEY_ID=

# Signed execution provenance
AGENCY_PROVENANCE_HMAC_SECRET=
AGENCY_PROVENANCE_KEY_ID=agency-os-local

# OpenTelemetry; send OTLP to a collector rather than directly to a vendor in production.
AGENCY_OTEL_ENABLED=false
OTEL_SERVICE_NAME=agency-os
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AGENCY_OTEL_SAMPLE_RATIO=1

# Usage accounting. Tenant price catalogs are managed through the API.
AGENCY_USAGE_RETENTION_DAYS=730

# Legacy deployment-wide integration fallbacks. These are ignored unless
# AGENCY_ALLOW_GLOBAL_INTEGRATION_FALLBACK=true, which production rejects.
# Store production tenant values through /api/tenants/current/secrets.
LINEAR_API_KEY=
LINEAR_AUTH_MODE=api_key
LINEAR_TEAM_ID=
GITHUB_TOKEN=
GITHUB_ORG=
