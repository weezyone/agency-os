{
  "name": "agency-os",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "runner": "tsx src/runner/execution-runner.ts",
    "runner:once": "tsx src/runner/execution-runner.ts --once",
    "sandbox:build": "docker build -f docker/sandbox.Dockerfile -t agency-os-sandbox:0.7.0 .",
    "staging:acceptance": "tsx scripts/staging-acceptance.ts",
    "validate:release": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1119.0",
    "@mastra/core": "1.61.0",
    "@mastra/memory": "1.26.0",
    "@mastra/mongodb": "1.15.1",
    "mongodb": "^7.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.0",
    "openid-client": "^6.8.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "0.220.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4",
    "tsx": "^4.20.4",
    "yaml": "^2.8.1"
  }
}
